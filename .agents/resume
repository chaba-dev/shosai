#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_bin="$HOME/.nix-profile/bin/nix"

if [[ ! -x "$nix_bin" ]]; then
  echo "Nix is not installed; run .agents/setup to restore the development environment." >&2
  exit 1
fi

cd "$repo_root"
echo "Nix development environment is available for $repo_root."
