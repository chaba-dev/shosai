#!/usr/bin/env bash
set -euo pipefail

tailscale_running() {
  sudo tailscale status --json 2>/dev/null |
    python3 -c 'import json, sys; raise SystemExit(0 if json.load(sys.stdin).get("BackendState") == "Running" else 1)'
}

if tailscale_running; then
  exit 0
fi

if [[ -z "${TAILSCALE_CLIENT_ID:-}" || -z "${TAILSCALE_TRUST_AUDIENCE:-}" ]]; then
  echo "Tailscale login deferred: set non-empty TAILSCALE_CLIENT_ID and TAILSCALE_TRUST_AUDIENCE." >&2
  exit 0
fi

tailscale_tag="${TAILSCALE_TAG:-tag:amp-demo}"
if [[ "$tailscale_tag" != tag:* ]]; then
  echo "TAILSCALE_TAG must use the tag:<name> form." >&2
  exit 1
fi

umask 077
token_file="$(mktemp)"
cleanup() {
  rm -f "$token_file"
}
trap cleanup EXIT INT TERM

amp orb id-token --audience "$TAILSCALE_TRUST_AUDIENCE" >"$token_file"
sudo tailscale up \
  --client-id="$TAILSCALE_CLIENT_ID?ephemeral=true&preauthorized=true" \
  --id-token="file:$token_file" \
  --advertise-tags="$tailscale_tag" \
  --hostname=amp-shosai

if ! tailscale_running; then
  echo "Tailscale did not reach Running state after enrollment." >&2
  exit 1
fi
